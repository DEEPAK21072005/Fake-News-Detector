# VeritasAI Environment Configuration
APP_NAME=VeritasAI
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/veritas.db
SYNC_DATABASE_URL=sqlite:///./data/veritas.db

# Resource & Execution Modes: FAST | BALANCED | RESEARCH | CLOUD_ENHANCED
DEFAULT_INFERENCE_MODE=BALANCED

# Embeddings & Vision
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
MAX_ARTICLE_TOKENS=1024
CHUNK_SIZE_TOKENS=256
CHUNK_OVERLAP_TOKENS=32

# Vision & OCR
ENABLE_OCR=true
VISION_MODEL_NAME=mobilenet_v3_small

# Optional External LLM Integration (Leaves empty for offline NullProvider)
LLM_PROVIDER=null
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Security & Constraints
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=["jpg", "jpeg", "png", "webp", "bmp"]
SCRAPER_TIMEOUT_SECONDS=10
MAX_SCRAPED_CHARS=50000
